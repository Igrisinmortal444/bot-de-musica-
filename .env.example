# Copia este archivo a .env y pon tu token NUEVO de BotFather.
# (El token que apareció en el chat quedó expuesto: usa /revoke en @BotFather y genera otro.)
BOT_TOKEN=REEMPLAZA_ME

# ID de Telegram del dueño (opcional). Déjalo en 0 si no lo sabes.
OWNER_ID=0

# Descargas simultáneas.
WORKERS=2

# Resultados por búsqueda.
SEARCH_RESULTS=12

# Máximo tamaño por canción en MB.
MAX_UPLOAD_MB=45

# Cookies de sesión de YouTube (opcional pero muy recomendado en Render):
# exporta cookies con la extensión "Get cookies.txt LOCALLY" y pégala en base64:
#   base64 -w0 cookies.txt
# Sin ella, YouTube puede pedir "confirma que no eres un bot" en IPs de datacenter.
YOUTUBE_COOKIES_B64=

# Puerto interno del servidor POT (bgutil) dentro del container de Render.
POT_PROVIDER_PORT=4416

# ARL de Deezer (opcional, PERO es el que da la descarga HQ en MP3 320/128).
# Cómo obtenerlo: inicia sesión en deezer.com desde tu navegador → F12 →
# Aplicación/Cookies → copia el valor de la cookie "arl" (parece una cadena larga
# y al azar). Sin ARL, el bot solo descarga de SoundCloud.
DEEZER_ARL=

# Tiendas de iTunes consultadas (catálogo mundial).
ITUNES_COUNTRIES=US,GB,DE,FR,ES,MX,BR,AR,CO,CL,PE,JP,KR,IN,NG,TR,IT,NL,SE,PL,EG,KZ,PH,ZA,AU