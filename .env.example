# Copia este archivo a .env y pon tu token NUEVO de BotFather.
# (El token que apareció en el chat quedó expuesto: usa /revoke en @BotFather y genera otro.)
BOT_TOKEN=REEMPLAZA_ME

# ID de Telegram del dueño (opcional). Déjalo en 0 si no lo sabes.
OWNER_ID=0

# Descargas simultáneas.
WORKERS=2

# Resultados por búsqueda.
SEARCH_RESULTS=12

# Máximo tamaño por canción en MB.
MAX_UPLOAD_MB=45

# Tiendas de iTunes consultadas (catálogo mundial).
ITUNES_COUNTRIES=US,GB,DE,FR,ES,MX,BR,AR,CO,CL,PE,JP,KR,IN,NG,TR,IT,NL,SE,PL,EG,KZ,PH,ZA,AU